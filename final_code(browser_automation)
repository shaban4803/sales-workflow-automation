    # Loop through the open tabs
    for index, url in enumerate(profile_links):
        print(f"\n  Tab {index + 1}: {url}")
        result = extract_from_current_tab(url)
        results.append(result)

        if index < len(profile_links) - 1:
            pyautogui.hotkey("ctrl", "tab")
            time.sleep(3)

