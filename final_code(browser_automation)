    time.sleep(1)
    pyautogui.hotkey("ctrl", "c")
    time.sleep(2)

    clip = pyperclip.paste()
    if not clip.strip():
        print(" Clipboard empty.")
        return [], [], clip

    emails = re.findall(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", clip)
    phones = [p.strip() for p in re.findall(r"\+\d[\d\s\-()]{7,}", clip)]
    return emails, phones, clip

def chunk_list(lst, size):
    for i in range(0, len(lst), size):
        yield lst[i:i + size]

