# --- Main Logic ---

def chunk_list(lst, size):
    """Split a list into chunks of size `size`"""
    for i in range(0, len(lst), size):
        yield lst[i:i + size]

for i, profile_links in enumerate(chunk_list(linkedin_profiles, 3)):
    chrome_profile = chrome_profiles[i % len(chrome_profiles)]
    print(f"\n Opening Chrome with {chrome_profile} for links: {profile_links}")

    # Launch Chrome with selected profile
    chrome_process = subprocess.Popen([
        'start', 'chrome',
        '--remote-debugging-port=9222',
        f'--user-data-dir={CHROME_USER_DIR}',
        f'--profile-directory={chrome_profile}',
        *profile_links
    ], shell=True)

    # Wait for Chrome to fully load
