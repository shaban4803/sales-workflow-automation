            time.sleep(10)

            for idx, (person_id, url) in enumerate(chunk):
                try:
                    if not url:
                        print(f"Skipping profile {person_id} - no URL")
                        continue

                    current_profile_index = current_batch_start + idx + 1
                    print(f"\n[Tab {idx + 1}] Profile {current_profile_index}: Processing PeopleId {person_id}")
