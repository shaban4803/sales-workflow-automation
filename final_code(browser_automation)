        ("ProfileName","EmailCredits","PhoneCredits","TotalCredits","CreatedAt")
        VALUES (%s,%s,%s,%s,now())
        ''',
        (profile, email_credits, phone_credits, total)
    )
    conn.commit()
    print(f"Logged credits for {profile}: emails={email_credits}, phones={phone_credits}, total={total}")

# --- GUI Helpers (your original ones) ---
def wait_until_found_and_click(image, confidence=0.6):
    print(f" Waiting for image: {image}")
    while True:
        try:
            loc = pyautogui.locateOnScreen(image, confidence=confidence)
            if loc:
                pyautogui.moveTo(pyautogui.center(loc), duration=0.5)
                pyautogui.click()
                return
        except Exception:
            pass
        time.sleep(1)

def try_click_with_timeout(image, timeout=9, confidence=0.6):
    print(f" Trying click {image} for {timeout}s...")
    end = time.time() + timeout
    while time.time() < end:
        try:
            loc = pyautogui.locateOnScreen(image, confidence=confidence)
            if loc:
                pyautogui.moveTo(pyautogui.center(loc), duration=0.5)
                pyautogui.click()
                return True
        except Exception:
            pass
        time.sleep(1)
    print(f" Timeout: {image} not found.")
    return False

