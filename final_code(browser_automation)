                    print(f"Progress saved at index: {current_profile_index}")

                    if idx < len(chunk) - 1:
                        print("Switching to next tab...")
                        pyautogui.hotkey("ctrl", "tab")
                        time.sleep(3)

                except Exception as e:
                    print(f"Error processing profile {person_id}: {e}")
                    # Continue with next profile instead of crashing
                    continue

            # Mark batch as completed
            mark_done(ids)
            print(f"Batch {i + 1} completed successfully!")

            # Kill Chrome safely
            try:
                print("Closing Chrome...")
                os.system("taskkill /F /IM chrome.exe")
                time.sleep(5)
            except Exception as e:
                print(f"Error killing Chrome: {e}")

        except Exception as e:
