# index tracking functions
def get_last_index():
    cur.execute('SELECT "index" FROM "Raw"."IndexCount" ORDER BY "index" DESC LIMIT 1')
    result = cur.fetchone()
    return result[0] if result else 0


def save_current_index(index):
    cur.execute('INSERT INTO "Raw"."IndexCount" ("index") VALUES (%s)', (index,))
    conn.commit()


# insertion logic etc.
def fetch_pending_profiles(limit=30):
    start_index = get_last_index()
    print(f" Starting from index: {start_index}")
    print(f" Fetching up to {limit} unprocessed profiles from Staging.People...")
    cur.execute(
        'SELECT "Id", "LinkedIn" FROM "Staging"."People" WHERE "Status" = FALSE AND "LinkedIn" IS NOT NULL OFFSET %s LIMIT %s',
        (start_index, limit))
    rows = cur.fetchall()
    print(f" Fetched {len(rows)} profiles.")
    return rows


def insert_email(email, people_id):
    # 1. Get company_id from People table
    cur.execute(
        'SELECT "CompanyId" FROM "Staging"."People" WHERE "Id" = %s',
        (str(people_id),)
    )
    result = cur.fetchone()

    if not result:
        print(f"No company found for PeopleId: {people_id}")
        return

    company_id = result[0]

    # Handle None company_id
    if company_id is None:
        print(f"CompanyId is None for PeopleId: {people_id}, inserting with NULL")
        company_id_param = None
    else:
        company_id_param = str(company_id)

    # 2. Insert email (omit Id — let it auto-increment)
    cur.execute(
        '''
        INSERT INTO "Staging"."Email"
        ("Email", "PeopleId", "CompanyId", "CreatedAt", "UpdatedAt")
        VALUES (%s, %s, %s, now(), now())
        ''',
        (email, str(people_id), company_id_param)
    )
    conn.commit()
    print("Email inserted successfully")

    print(f"Inserted email for PeopleId: {people_id}")


