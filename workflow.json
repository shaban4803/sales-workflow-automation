      "parameters": {
        "jsCode": "// Get the results array from the first input item\nconst results = $input.all()[0].json.results; // Assuming 'results' is in the first item\n\n// Loop over each place in the results array\nfor (const item of results) {\n  // Add the required fields to each item\n  item.CompanyName = item.name;\n  item.Ratings = item.rating;\n  item.CompanyLat = item.geometry?.location?.lat;\n  item.CompanyLong = item.geometry?.location?.lng;\n  item.CompanyAddress = item.formatted_address;\n\n  // Clean up unused fields\n  delete item.name;\n  delete item.rating;\n  delete item.geometry;\n  delete item.formatted_address;\n  delete item.place_id;\n  delete item.icon;\n  delete item.plus_code;\n  delete item.user_ratings_total;\n  delete item.business_status;\n  delete item.types;\n}\n\n// Return the flattened data\nreturn results.map(item => ({ json: item }));\n"
      },
