    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nSELECT \n  c.\"CompanyId\",\n  c.\"CompanyName\",\n  c.\"CompanyURL\",\n  c.\"CompanyBusinessHours\",\n  c.\"CompanyDescription\",\n  c.\"CompanyLogoURL\",\n  c.\"CompanyAddress\",\n  c.\"CompanyLat\",\n  c.\"CompanyLong\",\n  c.\"JobId\",\n  c.\"UUID\" AS \"CompanyUUID\",\n  c.\"ratings\",\n  c.\"CreatedAt\" AS \"CompanyCreatedAt\",\n  c.\"UpdatedAt\" AS \"CompanyUpdatedAt\",\n\n  p.\"Id\" AS \"PeopleId\",\n  p.\"Name\" AS \"PeopleName\",\n  p.\"LinkedIn\" AS \"PeopleLinkedIn\",\n  p.\"Designation\" AS \"PeopleDesignation\",\n  p.\"UUID\" AS \"PeopleUUID\",\n  p.\"CreatedAt\" AS \"PeopleCreatedAt\",\n  p.\"UpdatedAt\" AS \"PeopleUpdatedAt\",\n\n  con.\"Id\" AS \"ContactId\",\n  con.\"ContactNumber\",\n  con.\"UUID\" AS \"ContactUUID\",\n  con.\"CreatedAt\" AS \"ContactCreatedAt\",\n  con.\"UpdatedAt\" AS \"ContactUpdatedAt\",\n\n  e.\"Id\" AS \"EmailId\",\n  e.\"Email\",\n  e.\"UUID\" AS \"EmailUUID\",\n  e.\"CreatedAt\" AS \"EmailCreatedAt\",\n  e.\"UpdatedAt\" AS \"EmailUpdatedAt\",\n\n  sm.\"Id\" AS \"SocialMediaProfileId\",\n  sm.\"LinkedInURL\",\n  sm.\"FacebookURL\",\n  sm.\"TwitterURL\",\n  sm.\"UUID\" AS \"SocialMediaUUID\",\n  sm.\"CreatedAt\" AS \"SocialMediaCreatedAt\",\n  sm.\"UpdatedAt\" AS \"SocialMediaUpdatedAt\"\n\nFROM (\n  SELECT *\n  FROM \"Staging\".\"Company\"\n  ORDER BY \"CreatedAt\" DESC\n) c\n\nLEFT JOIN \"Staging\".\"People\" p\n  ON c.\"CompanyId\" = p.\"CompanyId\"\n\nLEFT JOIN \"Staging\".\"Contact\" con\n  ON con.\"CompanyId\" = c.\"CompanyId\"\n\nLEFT JOIN \"Staging\".\"Email\" e\n  ON e.\"CompanyId\" = c.\"CompanyId\"\n\nLEFT JOIN \"Staging\".\"SocialMediaProfile\" sm\n  ON c.\"CompanyId\" = sm.\"CompanyId\"\n  where c.\"CompanyId\" in ({{ $json.CompanyId }})\n  ORDER BY c.\"CompanyId\" ASC;",
        "options": {}
      },
