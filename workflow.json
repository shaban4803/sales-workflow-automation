    {
      "parameters": {
        "jsCode": "// Loop over each company and fetch data\nfor (const item of $input.all()) {\n  const companyId = item.json.CompanyId; // Get companyId from the current input\n  const companyName = item.json.CompanyName; // Get companyName from the current input\n\n  // 10 APIs in fallback order, with the real API moved to the 4th position\n  const queries = [\n    `https://www.googleapis.com/customsearch/v1?key=AIzaSyBKlhh9o2fuYQDwqfQjlWRYSuhMVJya_k8&cx=d18f9d9f6ba854b79&q=${encodeURIComponent(companyName + ' CEO OR CTO OR COO OR CFO OR CIO OR OWNER OR DIRECTOR FINANCE OR ERP MANAGER OR DIRECTOR ERP OR PRESIDENT OR VICE PRESIDENT OR DIRECTOR IT site:linkedin.com')}`, // fake\n    `https://api2.example.com/search?q=${encodeURIComponent(companyName)}`, // fake\n    `https://api3.example.com/search?q=${encodeURIComponent(companyName)}`, // fake\n    //  Corrected real Google API call moved to 4th position\n    `https://www.googleapis.com/customsearch/v1?key=AIzaSyCw_dfEUYnAMpzU9ygHnWZ90uFuV1lvvjo&cx=d18f9d9f6ba854b79&q=${encodeURIComponent(companyName + ' CEO OR CTO OR COO OR CFO OR CIO OR OWNER OR DIRECTOR FINANCE OR ERP MANAGER OR DIRECTOR ERP OR PRESIDENT OR VICE PRESIDENT OR DIRECTOR IT site:linkedin.com')}`,\n    `https://api5.example.com/search?q=${encodeURIComponent(companyName)}`, // fake\n    `https://api6.example.com/search?q=${encodeURIComponent(companyName)}`, // fake\n    `https://api7.example.com/search?q=${encodeURIComponent(companyName)}`, // fake\n    `https://api8.example.com/search?q=${encodeURIComponent(companyName)}`, // fake\n    `https://api9.example.com/search?q=${encodeURIComponent(companyName)}`, // fake\n  ];\n\n  let result = null;\n  let attemptLogs = [];\n  let lastError = null;\n  let sourceUrl = null;\n\n  attemptLogs.push(`Starting search for company ID: ${companyId}, Company Name: ${companyName}`);\n\n  // Attempt to get data from APIs\n  for (const [index, url] of queries.entries()) {\n    try {\n      attemptLogs.push(`Attempt ${index + 1}: Trying ${url}`);\n\n      const response = await this.helpers.httpRequest({\n        method: 'GET',\n        url: url,\n        json: true,\n      });\n\n      const data = response.items || response.results || response;\n\n      if (data && Array.isArray(data) && data.length > 0) {\n        attemptLogs.push(`Success at: ${url}`);\n        \n        // Convert the result to an object format (e.g., key-value mapping)\n        // This assumes the data has a property (e.g., 'id' or another unique key)\n        result = data.reduce((acc, item, idx) => {\n          // Use 'id' or any other unique key as the key for the object\n          acc[`item_${idx + 1}`] = item;\n          return acc;\n        }, {});\n        \n        sourceUrl = url;\n        break;\n      } else {\n        attemptLogs.push(`No data at: ${url}`);\n      }\n    } catch (error) {\n      lastError = error.message;\n      attemptLogs.push(`Error at: ${url} => ${lastError}`);\n    }\n\n    await new Promise(resolve => setTimeout(resolve, 1000)); // Delay between requests\n  }\n\n  // Wrap the results and logs in a structured JSON format\n  const responseJson = {\n    companyId: companyId,\n    companyName: companyName,\n    status: result ? 'success' : 'failed',\n    result: result || {},  // Include the result as an object or an empty object\n    attemptLogs: attemptLogs, // Include all logs for the API attempts\n    error: lastError || 'All APIs failed',  // Provide error details if any\n    sourceUrl: sourceUrl || null,  // Include the URL where data was fetched from\n    myNewField: 1, // Custom field as requested\n  };\n\n  // Replace the original item JSON with the new response format\n  item.json = responseJson;\n}\n\nreturn $input.all();\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        960
      ],
      "id": "581cc678-acd1-4e62-b178-c153d79a2636",
      "name": "Google(API)"
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const companyId = item.json.company_id;\n  const dataItems = item.json.data;\n\n  for (const [key, value] of Object.entries(dataItems)) {\n    results.push({\n      json: {\n        company_id: companyId,\n        item_key: key,  // optional: include the original item key\n        ...value\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
